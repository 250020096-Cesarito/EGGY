<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF3E2"
    tools:context=".MainActivity">

    <!-- ========================================== -->
    <!-- CABECERA: TÍTULO DE LA APLICACIÓN          -->
    <!-- ========================================== -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="EGGY"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#D4A373"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ========================================== -->
    <!-- SECCIÓN IZQUIERDA: NIVEL Y BARRA DE ENERGÍA  -->
    <!-- ========================================== -->
    <TextView
        android:id="@+id/tvNivel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="Nivel 1"
        android:textColor="#D4A373"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/progressBarEnergy"
        app:layout_constraintEnd_toEndOf="@id/progressBarEnergy"
        app:layout_constraintStart_toStartOf="@id/progressBarEnergy" />

    <ProgressBar
        android:id="@+id/progressBarEnergy"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="27dp"
        android:layout_height="217dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="40dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/energy_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <TextView
        android:id="@+id/tvProgresoNumerico"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="0/100"
        android:textColor="#D4A373"
        android:textSize="10sp"
        app:layout_constraintEnd_toEndOf="@id/progressBarEnergy"
        app:layout_constraintStart_toStartOf="@id/progressBarEnergy"
        app:layout_constraintTop_toBottomOf="@id/progressBarEnergy" />

    <!-- ========================================== -->
    <!-- SECCIÓN DERECHA: CONTADOR DE MONEDAS       -->
    <!-- ========================================== -->
    <TextView
        android:id="@+id/tvCoins"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="24dp"
        android:text="🪙 0"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#D4A373"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ========================================== -->
    <!-- MASCOTA CENTRAL (HUEVO / TAMAGOTCHI)       -->
    <!-- ========================================== -->
    <ImageView
        android:id="@+id/ivEgg"
        android:layout_width="195dp"
        android:layout_height="219dp"
        android:layout_marginTop="40dp"
        android:src="@mipmap/ic_launcher"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <!-- ========================================== -->
    <!-- SECCIÓN INFERIOR: CONTENEDOR DE OBJETIVOS  -->
    <!-- ========================================== -->
    <LinearLayout
        android:id="@+id/layoutBottomSection"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivEgg">

        <!-- Cabecera de objetivos diarios y botón flotante para agregar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅 Objetivos completados hoy"
                    android:textColor="#D4A373"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvObjetivosCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:text="0/0"
                    android:textColor="#D4A373"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Botón flotante corregido con el icono de más (+) -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnAddGoal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:clickable="true"
                android:focusable="true"
                app:srcCompat="@android:drawable/ic_input_add"
                app:backgroundTint="#B5E48C"
                app:tint="#FFFFFF" />
        </RelativeLayout>

        <!-- Lista desplazable donde se cargarán dinámicamente los objetivos -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/containerGoals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

    </LinearLayout>

    <!-- ========================================== -->
    <!-- BARRA DE NAVEGACIÓN INFERIOR (BLANCA Y AL FONDO) -->
    <!-- ========================================== -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🏠"
            android:textSize="20sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🌍"
            android:textSize="20sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🛖"
            android:textSize="20sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🐾"
            android:textSize="20sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="❤️"
            android:textSize="20sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>